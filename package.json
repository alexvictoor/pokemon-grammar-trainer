{
  "name": "pokemon-anglais",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm content:check && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "content:record-verdicts": "tsx scripts/record-verdicts.ts",
    "snapshot:pokemon": "tsx scripts/snapshot-pokemon.ts",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "arktype": "^2.2.9",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
